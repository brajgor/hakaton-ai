  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.3.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.3.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaiDrikstu.Api\VaiDrikstu.Api.csproj" />
    <ProjectReference Include="..\VaiDrikstu.DataImporter\VaiDrikstu.DataImporter.csproj" />
  </ItemGroup>
</Project>
